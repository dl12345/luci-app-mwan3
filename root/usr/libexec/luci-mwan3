. /lib/functions.sh
. /lib/functions/network.sh
. /usr/share/libubox/jshn.sh

ID=0

# Default rule-base priorities, applied when the matching mwan3.globals UCI
# option is unset. These mirror the core mwan3 defaults and the LuCI
# constants in mwan3/constants.js; keep all three in step.

IIF_RULE_BASE_DEFAULT=1000
FWMARK_RULE_BASE_DEFAULT=2000
UNREACHABLE_RULE_BASE_DEFAULT=3000

usage() {
	local status="$1"
	local msg="$2"
	if [ -n "$msg" ]; then
		echo "$msg"
		echo ""
	fi
	echo "Usage: $(basename "$0") <command>"
	echo "command:"
	echo "  diag:   diagnostic commands"
	echo "  nftset:  nft set commands"
	echo ""
	echo "diag <command> <iface>"
	echo "command:"
	echo "  gateway <iface>:   ping interface gateway"
	echo "  tracking <iface>:  ping interface tracking targets"
	echo "  rules <iface>:     check interface routing rules"
	echo "  routes <iface>:    check interface routing tables"
	echo ""
	echo "nftset <command>"
	echo "command:"
	echo "  dump:     show all non-internal nft set names in inet mwan3"

	exit "$status"
}

diag_gateway() {
	local iface="$1"

	local gw

	network_get_gateway gw "${iface}"
	[ -z "$gw" ] && network_get_gateway gw "${iface}_4"

	[ -z "$gw" ] && {
		echo "No gateway for interface ${iface} found."
		exit 2
	}

	mwan3 use "$iface" "ping" "-c" "5" "-W" "1" "$gw"
}

diag_tracking() {
	local iface="$1"

	checkips() {
		local ip="$1"
		local iface="$2"

		mwan3 use "$iface" "ping" "-c" "5" "-W" "1" "$ip"
	}

	config_load mwan3
	config_list_foreach "$iface" "track_ip" checkips "$iface"
}

iface_number() {
	local cfg="$1"
	local iface="$2"

	let number++

	[ "$cfg" = "$iface" ] && {
		ID="$number"
	}
}

diag_rules() {
	# Use the same diagnostic as the status page instead of independently
	# testing three IPv4 priorities for every interface, including IPv6.
	local iface="$1" report
	report="$(ubus call mwan3 routing_health)" || return 1
	printf '%s\n' "$report" | ucode -e '
		import { readfile } from "fs";
		const report = json(readfile("/dev/stdin"));
		const name = ARGV[0];
		const d = report.interfaces[name];
		if (!d) die("Unknown mwan3 interface");
		printf("IP rules for %s (%s), table %d:\n", name, d.family || "unknown", d.table.id);
		for (let key in ["iif_rule", "fwmark_rule", "unreach_rule", "src_rule"]) {
			const r = d[key];
			if (r == null) { printf("  %s: not applicable / not reported\n", key); continue; }
			printf("  %s (priority %d): %s\n", key, r.priority, r.present ? "present" : "absent");
			for (let address in r.addresses || []) printf("    from %s lookup %d\n", address, d.table.id);
		}
		for (let r in d.additional_rules || []) printf("  observed: %J\n", r);
	' "$iface"
}

diag_routes() {
	local iface="$1" number=0 family
	config_load mwan3
	config_foreach iface_number 'interface' "$iface"
	[ "$ID" != "0" ] || { echo "Unknown mwan3 interface"; return 2; }
	config_get family "$iface" family ipv4
	case "$family" in
		ipv4) family=4 ;;
		ipv6) family=6 ;;
		*) echo "Invalid interface protocol family"; return 2 ;;
	esac
	echo "IPv$family routing table $ID for interface $iface:"
	ip -"$family" route list table "$ID"
}

diag_cmd() {
	case "$1" in
		gateway)
			diag_gateway "$2"
			;;
		tracking)
			diag_tracking "$2"
			;;
		rules)
			diag_rules "$2"
			;;
		routes)
			diag_routes "$2"
			;;
		*)
			usage "1" "Command not supported"
			;;
	esac
}

nftset_dump() {
	nft list sets inet mwan3 2>/dev/null | awk '/^\tset / {print $2}' | grep -v '^mwan3_' | sort -u
}

nftset_cmd() {
	case "$1" in
		dump)
			nftset_dump
			;;
		*)
			usage "1" "Command not supported"
			;;
	esac
}

main () {
	case "$1" in
		diag)
			diag_cmd "$2" "$3"
			;;
		nftset)
			nftset_cmd "$2"
			;;
		*)
			usage "1" "Command not supported"
			;;
	esac
}

main "$@"
